<?xml version="1.0" encoding="utf-8"?>
<!--
    Lab 3 entry screen: one button per experiment, grouped by lab.
    Lab 3 added five more buttons on top of Lab 2's four, so the button column
    now lives inside a ScrollView; otherwise the last buttons would be pushed
    off screen on shorter devices.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lab_content_bg"
    android:orientation="vertical">

    <!--
        fitsSystemWindows is on this wrapper, not on the TextView inside it:
        the attribute rewrites the padding of whatever view carries it, which
        would drop the horizontal padding. The wrapper keeps the teal behind the
        status bar and the TextView keeps its own padding.
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/lab_teal"
        android:fitsSystemWindows="true"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp"
            android:text="@string/title_lab_menu"
            android:textColor="@color/white"
            android:textSize="20sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="8dp"
            android:paddingEnd="24dp"
            android:paddingBottom="24dp">

            <TextView
                style="@style/LabSectionText"
                android:text="@string/section_lab2" />

            <Button
                android:id="@+id/btnLinear"
                style="@style/LabMenuButton"
                android:text="@string/menu_linear" />

            <Button
                android:id="@+id/btnTable"
                style="@style/LabMenuButton"
                android:text="@string/menu_table" />

            <Button
                android:id="@+id/btnConstraint1"
                style="@style/LabMenuButton"
                android:text="@string/menu_constraint1" />

            <Button
                android:id="@+id/btnConstraint2"
                style="@style/LabMenuButton"
                android:text="@string/menu_constraint2" />

            <TextView
                style="@style/LabSectionText"
                android:text="@string/section_lab3" />

            <Button
                android:id="@+id/btnLab3List"
                style="@style/LabMenuButton"
                android:text="@string/menu_lab3_list" />

            <Button
                android:id="@+id/btnLab3Dialog"
                style="@style/LabMenuButton"
                android:text="@string/menu_lab3_dialog" />

            <Button
                android:id="@+id/btnLab3Menu"
                style="@style/LabMenuButton"
                android:text="@string/menu_lab3_menu" />

            <Button
                android:id="@+id/btnLab3ActionMode"
                style="@style/LabMenuButton"
                android:text="@string/menu_lab3_actionmode" />

            <Button
                android:id="@+id/btnLab3Recycler"
                style="@style/LabMenuButton"
                android:text="@string/menu_lab3_recycler" />
        </LinearLayout>
    </ScrollView>

</LinearLayout>
