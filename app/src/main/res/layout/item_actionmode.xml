<?xml version="1.0" encoding="utf-8"?>
<!--
    Lab 3 - experiment 4: one row of the ActionMode list (robot icon + name).

    The background is the point of this file. ?android:attr/activatedBackgroundIndicator
    is the system's "this row is selected" background (the blue one in the
    screenshot); it is painted as soon as the row is checked, which is why the
    activity calls ListView.setItemChecked() when the action mode starts and
    ListView.clearChoices() + notifyDataSetChanged() when it ends.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:background="?android:attr/activatedBackgroundIndicator"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">

    <ImageView
        android:id="@+id/ivItemIcon"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:contentDescription="@null"
        android:scaleType="fitCenter"
        android:src="@drawable/android_robot" />

    <TextView
        android:id="@+id/tvItem"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:textColor="@color/black"
        android:textSize="18sp"
        android:textStyle="bold"
        tools:text="One" />

</LinearLayout>
